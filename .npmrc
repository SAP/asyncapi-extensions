# Keep dependency versions reproducible.
package-lock=true
lockfile-version=3
save-exact=true

# Enforce supported runtimes and reject peer-dependency conflicts.
engine-strict=true
strict-peer-deps=true

# Block lifecycle scripts; this schema package has no required install or publish hooks.
ignore-scripts=true

# Keep install output quiet and registry requests bounded.
fund=false
update-notifier=false
fetch-retries=5
fetch-timeout=60000

# Verify TLS certificates when contacting the registry.
strict-ssl=true
